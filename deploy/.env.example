# 复制本文件为 .env 后填写：cp .env.example .env
# 安全：.env 含凭证，已在 .gitignore 中排除，切勿提交到任何仓库或贴进聊天。

# ---- GitHub 私有仓库同步（可选）----
# 用于把 vault 增量 push 到你的私有仓库做云端镜像
CUT_OBSIDIAN_GITHUB_REPO=你的账号/cut-obsidian-brain
CUT_OBSIDIAN_GITHUB_BRANCH=main
# token 留空更安全：进容器后调用 cm_github_setup 工具写入 0600 文件。
# 若非要写这里，请用仅对该仓库有读写权限的 fine-grained token。
CUT_OBSIDIAN_GITHUB_TOKEN=

# ---- 传输方式 ----
# stdio=本地模式；streamable-http=HTTP 远程（推荐）；sse=旧版 HTTP
MCP_TRANSPORT=streamable-http

TZ=America/Los_Angeles

# ── V0.5 多用户体系（GitHub OAuth 登录）──
# 注册地址：https://github.com/settings/developers → New OAuth App
#   Homepage URL:              http://154.12.41.33:8899
#   Authorization callback URL: http://154.12.41.33:8899/auth/callback
# 注册后把 Client ID / Secret 填到下面，重启容器生效
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# 会话有效期（秒）与闲置即焚阈值（秒），默认 24 小时 / 30 分钟
SESSION_TTL=86400
IDLE_WIPE_SEC=1800
