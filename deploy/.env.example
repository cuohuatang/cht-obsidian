# 复制本文件为 .env 后填写：cp .env.example .env
# 安全：.env 含凭证，已在 .gitignore 中排除，切勿提交到任何仓库或贴进聊天。

# ---- GitHub 私有仓库同步（可选）----
# 用于把 vault 增量 push 到你的私有仓库做云端镜像
CUT_OBSIDIAN_GITHUB_REPO=你的账号/cut-obsidian-brain
CUT_OBSIDIAN_GITHUB_BRANCH=main
# token 留空更安全：进容器后调用 cm_github_setup 工具写入 0600 文件。
# 若非要写这里，请用仅对该仓库有读写权限的 fine-grained token。
CUT_OBSIDIAN_GITHUB_TOKEN=

# ---- 传输方式 ----
# stdio=本地模式；streamable-http=HTTP 远程（推荐）；sse=旧版 HTTP
MCP_TRANSPORT=streamable-http

TZ=America/Los_Angeles

# ── V0.5 多用户体系（GitHub OAuth 登录）──
# 注册地址：https://github.com/settings/developers → New OAuth App
#   Homepage URL:              http://154.12.41.33:8899
#   Authorization callback URL: http://154.12.41.33:8899/auth/callback
# 注册后把 Client ID / Secret 填到下面，重启容器生效
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# 会话有效期（秒）与闲置即焚阈值（秒），默认 24 小时 / 30 分钟
SESSION_TTL=86400
IDLE_WIPE_SEC=1800

# ── V0.6 Harness² 嫁接（可选，默认不装）──
# cht-obsidian 内置 cm_harness2_* 7 工具驱动 Google Research 的 Harness² CLI
# （递归优化 Agent 外壳：提示词/护栏/记忆/工具指导）。云端版默认不安装 CLI——
# 每位用户需自带模型凭证（Vertex AI），此时调用 cm_harness2_* 会返回安装指引。
# 完整功能请在本地以 stdio 模式运行 cht-obsidian 并使用。
# 若 CLI 不在 PATH，可逐个指定可执行文件路径：
# HARNESS2_CMD_RUN=/path/to/harness2
# HARNESS2_CMD_DEMO=/path/to/harness2-demo
# HARNESS2_CMD_SETUP=/path/to/harness2-setup
# HARNESS2_CMD_CHECK=/path/to/harness2-check
# HARNESS2_CMD_JUDGE=/path/to/harness2-judge
# HARNESS2_CMD_REPORT=/path/to/harness2-report
# Harness² 仓库根目录（含 .env 与 runs/ 的目录）：
# HARNESS2_CWD=/path/to/harness2
