# 复制本文件为 .env 后填写：cp .env.example .env
# 安全：.env 含凭证，已在 .gitignore 中排除，切勿提交到任何仓库或贴进聊天。

# ---- GitHub 私有仓库同步（可选）----
# 用于把 vault 增量 push 到你的私有仓库做云端镜像
CUT_OBSIDIAN_GITHUB_REPO=你的账号/cut-obsidian-brain
CUT_OBSIDIAN_GITHUB_BRANCH=main
# token 留空更安全：进容器后调用 cm_github_setup 工具写入 0600 文件。
# 若非要写这里，请用仅对该仓库有读写权限的 fine-grained token。
CUT_OBSIDIAN_GITHUB_TOKEN=

# ---- 传输方式 ----
# stdio=本地模式；streamable-http=HTTP 远程（推荐）；sse=旧版 HTTP
MCP_TRANSPORT=streamable-http

TZ=America/Los_Angeles
